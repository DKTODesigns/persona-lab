# Required for real persona generation. Never commit a real key — copy this
# file to .env.local (already git-ignored) and fill it in there.
ANTHROPIC_API_KEY=

# Optional. Set to "true" to bypass the Claude API entirely and use the
# built-in mock persona generator instead — useful for local UI development
# without burning API credits. Defaults to unset/false (real API calls).
USE_MOCK_PERSONAS=false
